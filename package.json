{
  "name": "dep-trust-score",
  "version": "1.0.0",
  "description": "Calculate npm package reliability scores based on maintenance and security signals",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "trust-score": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "npm",
    "package",
    "reliability",
    "security",
    "maintenance",
    "trust-score",
    "dependency"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.2",
    "yargs": "^18.0.0",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/jest": "^30.0.0",
    "typescript": "^6.0.3",
    "ts-node": "^10.9.2",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "nock": "^14.0.13"
  }
}
